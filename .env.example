# Google AdSense display ad unit IDs.
# 在 AdSense 后台创建「展示广告」广告单元后，把广告代码里的 data-ad-slot 填到这里。
VITE_ADSENSE_ARTICLE_TOP_SLOT=1186044026
VITE_ADSENSE_ARTICLE_BOTTOM_SLOT=4849956868
VITE_ADSENSE_SIDEBAR_SLOT=8697398610

# 低质量/弹窗类广告会影响页面体验，默认关闭。确认需要时再启用。
VITE_ENABLE_MONDIAD=false

# Nolebase 的逐页 OG 图片生成对包含 % 的中文文件名不稳定，默认关闭。
VITE_ENABLE_OG_IMAGE=false
